<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> · App Control</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <header>
      <a class="brand" href="/">C<span>APP CONTROL</span>
      </a>
      <nav>
        <a href="/#sso-panel">เชื่อม SSO ใหม่</a>
        <a href="/">ภาพรวม</a>
        <% if(currentUser.is_admin){ %>
        <a href="/users">ผู้ใช้และสิทธิ์ระบบ </a>
        <% } %>
      </nav>
      <div class="account">
        <span><%= currentUser.username %></span>
        <form method="post" action="/logout">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <button class="quiet">ออกจากระบบ</button>
        </form>
      </div>
    </header>
    <main class="container">
