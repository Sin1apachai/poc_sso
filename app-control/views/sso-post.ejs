<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>กำลังเข้าสู่ระบบ</title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body class="login-page">
    <main class="login-card">
      <h1>กำลังเข้าสู่ระบบ</h1>
      <p>กำลังขอ token กลาง กรุณารอสักครู่</p>
      <iframe name="kc-handoff" title="เชื่อมต่อ SSO" hidden></iframe>
      <form id="sso-response" method="post" target="kc-handoff" action="<%= action %>"
        data-fallback="<%= fallback %>">
        <input type="hidden" name="assertion" value="<%= assertion %>">
        <noscript>
          <p>กรุณาเปิด JavaScript เพื่อเข้าสู่ระบบ SSO</p>
        </noscript>
      </form>
    </main>
    <script src="/sso-post.js" defer></script>
  </body>
</html>
