meta {
  name: 06 Revoke
  type: http
  seq: 6
}

post {
  url: {{keycloak_url}}/realms/{{realm}}/temporary-sso-poc/revoke
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  token: {{request_access_token}}
  client_id: {{authority_client_id}}
  client_secret: {{authority_client_secret}}
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("expected_active", false);
    bru.setVar("expected_logout_minimum", 0);
  }
}

tests {
  test("C authority revokes the selected token", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().revoked).to.equal(true);
  });
}

docs {
  เพิกถอน token ทันที ถ้าใส่ access_token จริงจะยกเลิกใบจริงนั้น
  หลังส่งรัน 05 เพื่อตรวจ active=false เส้นนี้ใช้ authority credentials ของ C
  การเรียกตรงนี้ไม่แจ้ง A/B ออกทันทีเหมือนปุ่ม Logout ของ C
}
