meta {
  name: 02 JWKS
  type: http
  seq: 2
}

get {
  url: {{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/certs
  body: none
  auth: none
}

tests {
  test("Realm exposes public verification keys only", () => {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().keys).to.be.an("array").that.is.not.empty;
    res.getBody().keys.forEach(key => expect(key).not.to.have.property("d"));
  });
}

docs {
  Public keys สำหรับตรวจลายเซ็น JWT ไม่ใช่ Client Secret
}
