{
  "mode": "JWT Authorization Grant (C-only IdP)",
  "idp": {
    "issuer": "http://localhost:4003/oidc",
    "jwksUrl": "http://app-control:4003/oidc/jwks",
    "jwtAuthorizationGrantAssertionReuseAllowed": "false",
    "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "60",
    "jwtAuthorizationGrantAssertionSignatureAlg": "RS256",
    "jwtAuthorizationGrantLimitAccessTokenExp": "false",
    "providerId": "jwt-authorization-grant",
    "useJwksUrl": "true"
  },
  "clients": {
    "app-a": {
      "standardFlowEnabled": false,
      "jwtGrantEnabled": "true",
      "allowedIdp": "app-control",
      "mappers": [
        {
          "name": "control-permissions",
          "type": "oidc-usermodel-client-role-mapper"
        },
        {
          "name": "control-source-idp",
          "type": "oidc-hardcoded-claim-mapper"
        },
        {
          "name": "control-audience",
          "type": "oidc-audience-mapper"
        }
      ],
      "clientAuthentication": true,
      "fullScopeAllowed": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["profile", "email"],
      "roleScope": ["app-a/read", "app-a/write", "app-a/delete"]
    },
    "app-b": {
      "standardFlowEnabled": false,
      "jwtGrantEnabled": "true",
      "allowedIdp": "app-control",
      "mappers": [
        {
          "name": "control-source-idp",
          "type": "oidc-hardcoded-claim-mapper"
        },
        {
          "name": "control-permissions",
          "type": "oidc-usermodel-client-role-mapper"
        },
        {
          "name": "control-audience",
          "type": "oidc-audience-mapper"
        }
      ],
      "clientAuthentication": true,
      "fullScopeAllowed": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["profile", "email"],
      "roleScope": ["app-b/read", "app-b/write", "app-b/delete"]
    },
    "app-control": {
      "standardFlowEnabled": false,
      "jwtGrantEnabled": "true",
      "allowedIdp": "app-control",
      "mappers": [
        {
          "name": "control-source-idp",
          "type": "oidc-hardcoded-claim-mapper"
        },
        {
          "name": "control-audience",
          "type": "oidc-audience-mapper"
        }
      ],
      "clientAuthentication": true,
      "fullScopeAllowed": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["profile", "email"],
      "roleScope": []
    },
    "app-control-sync": {
      "clientAuthentication": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "jwtGrantEnabled": "false",
      "defaultClientScopes": ["roles"],
      "serviceAccountRoles": ["realm-management/manage-users", "realm-management/view-clients"],
      "roleScope": ["realm-management/manage-users", "realm-management/view-clients"]
    }
  },
  "realmAccessTokenSeconds": 300,
  "referenceOnly": true,
  "note": "Reference only, not an import file. Minimal scopes/roles validated on isolated Keycloak 26.8.1 with all 12 Admin API templates; no client secrets."
}
