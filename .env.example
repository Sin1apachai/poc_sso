# Copy to .env and replace placeholders before running Docker Compose.
APP_A_PORT=4001
APP_A_SYSTEM_ID=app-a
APP_A_SYSTEM_NAME=ระบบ A
APP_A_PUBLIC_URL=http://localhost:4001
APP_A_OTHER_APP_URL=http://localhost:4002
APP_A_COOKIE_NAME=app_a_session
APP_A_SESSION_SECRET=replace-app-a-session-secret
APP_A_DB_NAME=app_a
APP_A_DB_USER=app_a_user
APP_A_DB_PASSWORD=replace-app-a-db-password
KC_ISSUER=http://localhost:8080/realms/sso-lab
KC_INTERNAL_URL=http://keycloak:8080/realms/sso-lab
APP_A_KC_CLIENT_ID=app-a
APP_A_KC_CLIENT_SECRET=replace-app-a-kc-client-secret
APP_B_PORT=4002
APP_B_SYSTEM_ID=app-b
APP_B_SYSTEM_NAME=ระบบ B
APP_B_PUBLIC_URL=http://localhost:4002
APP_B_OTHER_APP_URL=http://localhost:4001
APP_B_COOKIE_NAME=app_b_session
APP_B_SESSION_SECRET=replace-app-b-session-secret
APP_B_DB_NAME=app_b
APP_B_DB_USER=app_b_user
APP_B_DB_PASSWORD=replace-app-b-db-password
APP_B_KC_CLIENT_ID=app-b
APP_B_KC_CLIENT_SECRET=replace-app-b-kc-client-secret
CONTROL_SESSION_SECRET=replace-control-session-secret
CONTROL_DB_PASSWORD=replace-control-db-password
CONTROL_KC_CLIENT_SECRET=replace-control-kc-client-secret
CONTROL_SYNC_CLIENT_SECRET=replace-control-sync-client-secret
POSTGRES_PASSWORD=replace-postgres-password
